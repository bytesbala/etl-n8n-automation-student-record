      "id": "eabb9035-f7c8-4077-969f-dc9c395acf7b",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "LYdohCwzAkPBgVEA",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of items) {\n  // Change `output` if your AI response is stored in a different field\n  let raw = item.json.output ?? item.json.text ?? item.json.response ?? item.json;\n\n  // If the AI output is a JSON string, unwrap and parse it\n  if (typeof raw === 'string') {\n    raw = raw.trim();\n\n    // Removes Markdown code fences if the AI used them\n    raw = raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/i, '');\n\n    try {\n      raw = JSON.parse(raw);\n    } catch {\n      // If raw text contains an array somewhere inside it\n      const match = raw.match(/\\[[\\s\\S]*\\]/);\n      if (!match) {\n        results.push({\n          json: { error: 'Could not find a valid JSON array', raw },\n        });\n        continue;\n      }\n      raw = JSON.parse(match[0]);\n    }\n  }\n\n  const students = Array.isArray(raw) ? raw : [raw];\n\n  for (const student of students) {\n    const email =\n      typeof student.Email === 'string' &&\n      /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(student.Email)\n        ? student.Email.trim().toLowerCase()\n        : null;\n\n    const phone =\n      typeof student.Phone === 'string' &&\n      student.Phone !== 'MISSING'\n        ? student.Phone.replace(/\\D/g, '')\n        : null;\n\n    results.push({\n      json: {\n        Student_ID: student.Student_ID?.trim() || null,\n        Name: student.Name?.trim() || null,\n        Email: email,\n        Phone: phone,\n        Course: student.Course?.trim() || null,\n        Fee_Paid: Boolean(student.Fee_Paid),\n        City: student.City?.trim() || null,\n        Enrolled_Date: student.Enrolled_Date || null,\n\n        // Flags help you route or review incomplete records\n        needs_email_review: !email,\n        needs_phone_review: !phone,\n      },\n    });\n  }\n}\n\nreturn results;"
      },
